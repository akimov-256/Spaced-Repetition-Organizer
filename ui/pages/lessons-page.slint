import { EmptyState } from "empty-state.slint";
import { Button, LineEdit, ListView } from "std-widgets.slint";
import { ThemeState, DarkColorPalette, LightColorPalette } from "../theme/color-palette.slint";
import { LessonData } from "../models.slint";
import { LessonCard } from "../components/lesson-card.slint";

export component LessonsPage inherits Rectangle {
    // Properties
    in-out property <string> topic;
    in-out property <string> new_lesson_text: "";
    in-out property <[LessonData]> lessons: [];

    // Callbacks
    callback add_lesson(string);
    callback load_lessons_requested();
    callback delete_lesson(string);
    callback review_lesson(lesson: string, stage: int);
    callback rename_lesson(lesson: string);

    background: transparent;

    VerticalLayout {
        HorizontalLayout {
            padding: 10px;
            spacing: 10px;

            Text {
                vertical-alignment: center;
                height: 30px;

                text: topic;
                font-size: 20px;

                color: ThemeState.isLight ? LightColorPalette.Text : DarkColorPalette.Text;
            }

            LineEdit {
                placeholder-text: "New lesson name..";
                font-size: 16px;

                text <=> root.new_lesson_text;

                accepted() => {
                    if root.new_lesson_text != "" {
                        add_lesson(root.new_lesson_text);
                        root.new_lesson_text = "";
                    }
                }
            }

            Button {
                text: "Add lesson";

                icon: @image-url("../../assets/icons/add.svg");
                colorize-icon: true;

                enabled: root.new_lesson_text != "";

                clicked => {
                    add_lesson(root.new_lesson_text);
                    root.new_lesson_text = "";
                }
            }
        }

        VerticalLayout {
            padding: 10px;

            if lessons.length == 0 : EmptyState {
                main_text: "Nothing here!";
                tip_text: "Create a lesson to get started.";
            }

            if lessons.length != 0 : ListView {
                for lesson[i] in lessons : Rectangle {
                    height: 110px;
                    width: parent.width - 10px;

                    LessonCard {
                        width: parent.width - 10px;
                        x: 0px;
                        y: 10px;

                        name: lessons[lessons.length - 1 - i].name;
                        last_reviewed: lessons[lessons.length - 1 - i].previous_review;
                        next_review: lessons[lessons.length - 1 - i].next_review;
                        stage: lessons[lessons.length - 1 - i].stage;
                        due: lessons[lessons.length - 1 - i].due;

                        delete_requested => {
                            root.delete_lesson(lessons[lessons.length - 1 - i].name);
                        }

                        review_button_pressed => {
                            root.review_lesson(lessons[lessons.length - 1 - i].name, lessons[lessons.length - 1 - i].stage);
                        }

                        edit_requested => {
                            root.rename_lesson(lessons[lessons.length - 1 - i].name);
                        }
                    }
                }
            }
        }
    }
}